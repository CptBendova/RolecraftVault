<?xml version="1.0" encoding="utf-8"?>
<!--
  A crest with a keyhole: what the app is, rather than what it is called. A
  letter was tried first and rejected, and it deserved to be, since an initial
  says nothing that the name underneath it is not already saying.

  An adaptive icon is 108dp but a launcher may mask it down to roughly the
  middle 72dp, and every launcher masks a different shape. The crest spans
  x 26..82 and y 20..88, which sits inside that 18..90 window, so no mask
  clips it.

  The outline is a gradient rather than a flat brass because a flat one goes
  dull against the dark ground. The keyhole is the only solid brass, so it is
  the thing the eye lands on first at 48dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF121B33"
        android:strokeWidth="3"
        android:pathData="M54,20 L82,30 v22 c0,18 -13,29 -28,36 c-15,-7 -28,-18 -28,-36 V30 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="20"
                android:endX="0" android:endY="88">
                <item android:offset="0" android:color="#FFF5DCA0" />
                <item android:offset="0.5" android:color="#FFD9B25C" />
                <item android:offset="1" android:color="#FF9C7530" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M45,52 a9,9 0 1,1 18,0 a9,9 0 1,1 -18,0 Z M50,58 h8 l-2.5,14 h-3 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="43"
                android:endX="0" android:endY="72">
                <item android:offset="0" android:color="#FFF5DCA0" />
                <item android:offset="0.5" android:color="#FFD9B25C" />
                <item android:offset="1" android:color="#FF9C7530" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
